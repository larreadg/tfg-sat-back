DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dbname?schema=public"
# --- Supabase (produccion / Docker) ------------------------------------------
# Supabase > Connect > ORMs > Prisma. Se usan DOS cadenas del pooler:
#   DATABASE_URL -> modo transaccion, puerto 6543, con `pgbouncer=true` (la app)
#   DIRECT_URL   -> modo sesion, puerto 5432 (solo `prisma migrate deploy`)
# No usar la conexion directa `db.<ref>.supabase.co`: es solo IPv6 y la red por
# defecto de Docker no tiene IPv6.
# Si la contrasena tiene `$`, poner el valor entre comillas simples (Docker
# Compose interpreta `$` en el .env).
# DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# En Docker, las migraciones pendientes se aplican al arrancar el contenedor.
# Poner en false para aplicarlas a mano.
MIGRAR_AL_INICIAR=true
PORT=3000
HOST=0.0.0.0
# `trust proxy` de Express: de donde se acepta X-Forwarded-For para saber la IP
# real (rate-limit y auditoria). Local: loopback. En Docker detras de un proxy
# inverso: uniquelocal (ya es el default del docker-compose). Nunca `true`.
TRUST_PROXY=loopback
USE_HTTPS=false
SSL_KEY_PATH="ssl/key.pem"
SSL_CERT_PATH="ssl/cert.pem"
CORS_ORIGIN="http://localhost:4200"
SMS_API_URL="http://casa.deu.im:9000/app/sms/s.xhtml"
# Cloudflare Turnstile (RF-29). OBLIGATORIO: es el unico gate anti-bot de los
# flujos publicos (login del panel, validacion de telefono y envio de reporte).
# La app NO arranca sin este valor, a proposito: sin secret no habria verificacion.
# En desarrollo se puede usar la clave de prueba de Cloudflare, que siempre
# valida y no requiere cuenta:
#   secret de prueba : 1x0000000000000000000000000000000AA
#   sitekey de prueba: 1x00000000000000000000AA  (va en el front, environment.ts)
# En produccion, usar las claves reales del widget creado en el panel de Cloudflare.
TURNSTILE_SECRET=""
JWT_SECRET="changeme"
JWT_EXPIRES_IN="15m"
JWT_PRE_AUTH_EXPIRES_IN="5m"
JWT_REFRESH_SECRET="changeme-refresh"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_CIUDADANO_SECRET="changeme-ciudadano"
JWT_CIUDADANO_PRE_AUTH_EXPIRES_IN="5m"
JWT_CIUDADANO_SESSION_EXPIRES_IN="30m"
UPLOADS_DIR="uploads"
UPLOADS_BASE_URL="/uploads"
# Adjuntos de seguimiento de alertas (comentarios y pestaña Archivos). Carpeta
# PRIVADA: no se sirve como estatico, solo por endpoint autenticado. Tiene que
# quedar FUERA de UPLOADS_DIR.
ADJUNTOS_DIR="adjuntos-seguimiento"
OPENAI_API_KEY="sk-changeme"
OPENAI_MODEL="gpt-4o-mini"
EVALUACION_IA_CRON="*/2 * * * *"
EVALUACION_IA_BATCH_SIZE=5
EVALUACION_IA_MAX_INTENTOS=3

# --- Integracion Telegram (opcional) ---------------------------------------
# Poner TELEGRAM_ENABLED=true para activar el bot. Si esta activo, BOT_TOKEN y
# WEBHOOK_SECRET son obligatorios (la app tira excepcion al arrancar si faltan).
# El token lo da @BotFather. El secret es una cadena aleatoria propia (p.ej.
# `openssl rand -hex 32`) que valida que el webhook viene de Telegram.
# NUNCA commitear valores reales: esto es solo la plantilla.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_PATH="/api/v1/telegram/webhook"
# URL publica completa (https) que el servidor registra en Telegram al arrancar.
# Solo en el servidor: en local dejarla vacia, el webhook lo registra
# start-https.bat con la URL del tunel. Telegram entrega a UNA sola URL por bot:
# correr start-https.bat con el mismo token le saca el bot al servidor hasta que
# el contenedor se reinicie. Para desarrollo conviene un bot aparte.
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_SESION_EXPIRACION_HORAS=24

# Geocodificacion inversa (lat/lon -> departamento / ciudad / barrio / calle).
# Opcional: si se apaga o el proveedor falla, el reporte queda solo con coordenadas.
# Por defecto usa Nominatim publico (OpenStreetMap): gratuito, sin API key, pero
# su politica exige un User-Agent identificable y limita a 1 req/s. Los resultados
# se cachean en la tabla GeocodificacionCache por coordenada redondeada (~11 m).
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=AGUARD-TFG/1.0 (contacto@ejemplo.com)
GEOCODING_IDIOMA=es
GEOCODING_TIMEOUT_MS=5000

# --- Clave maestra de secretos de configuracion (opcional pero recomendada) ---
# Con esta clave el backend cifra (AES-256-GCM, ver shared/utils/crypto.ts) los
# secretos que el ADMIN carga desde el panel. Hoy el unico es la contrasena del
# servidor SMTP del tab Configuracion > Sistema.
# La app ARRANCA sin esta variable: recien falla, con mensaje claro, cuando alguien
# intenta guardar o usar una contrasena SMTP.
# Generar una con: openssl rand -hex 32
# ⚠️ Si se pierde o se cambia, los secretos ya guardados no se pueden descifrar y
# hay que volver a cargarlos desde el panel.
CONFIG_ENCRYPTION_KEY=""

# Solo DESARROLLO. Permite que una regla de webhook apunte a un destino en red
# privada o loopback (p.ej. un receptor local para probar). En produccion debe
# quedar en false / sin definir: la URL de una regla la elige un usuario y la
# visita el servidor, asi que sin este bloqueo seria una primitiva de SSRF hacia
# la red interna del backend. Ver shared/.../webhooks.despachador.ts
WEBHOOKS_PERMITIR_RED_PRIVADA=false
